// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CheckIn {
  id            String   @id @default(uuid())
  anonymousId   String   @db.VarChar(100)
  status        String   @default("active")
  checkInTime   DateTime @default(now())
  checkOutTime  DateTime?
  deviceInfo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Verification method: 'webauthn', 'software', or null (legacy)
  verificationMethod String?

  // Credential identifiers for verification (optional - for linking to credentials)
  credentialId   String? // For WebAuthn: the credentialId; For software: the keyFingerprint

  @@index([anonymousId])
  @@index([status])
  @@index([anonymousId, status])
  @@index([checkInTime])
}

// WebAuthn credentials linked to anonymousId
// Multiple credentials allowed per anonymousId (different devices)
model WebAuthnCredential {
  id              String   @id @default(uuid())
  anonymousId     String   // NOT unique - multiple credentials per anonymousId
  credentialId    String   @unique @db.Text // Base64URL encoded, unique identifier
  publicKey       String   @db.Text // Base64URL encoded
  counter         BigInt   @default(0)
  transports      String[] // e.g., ["usb", "ble", "nfc", "internal"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([anonymousId])
  @@index([credentialId])
}

// Software keys linked to anonymousId
// Multiple keys allowed per anonymousId (different devices)
model SoftwareKey {
  id              String   @id @default(uuid())
  anonymousId     String   // NOT unique - multiple keys per anonymousId
  keyFingerprint  String   @unique // SHA-256 hash of public key for lookup
  publicKeyJwk    String   @db.Text // JSON Web Key format
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([anonymousId])
  @@index([keyFingerprint])
}

model AuthChallenge {
  id          String   @id @default(uuid())
  anonymousId String
  challenge   String   @db.VarChar(100)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([anonymousId])
  @@index([expiresAt])
}
